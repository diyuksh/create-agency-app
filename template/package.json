{
  "name": "template.sar.ga",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "if [ -n \"$BASEHUB_TOKEN\" ]; then basehub dev & fi; bun ./src/lib/scripts/dev.ts",
    "dev:https": "if [ -n \"$BASEHUB_TOKEN\" ]; then basehub dev & fi; bun ./src/lib/scripts/dev.ts --https",
    "build": "if [ -n \"$BASEHUB_TOKEN\" ]; then basehub; fi && next build",
    "start": "next start",
    "preview": "bun run build && next start",
    "check": "biome check && tsc --noEmit && bun test",
    "clean": "rm -rf .next node_modules/.cache",
    "lint": "biome lint --max-diagnostics=200",
    "lint:fix": "biome lint --write --unsafe --max-diagnostics=200",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "typecheck:tsc": "tsc --noEmit --incremental false --stableTypeOrdering",
    "typecheck:compare": "bun run typecheck:tsc && bun run typecheck",
    "analyze": "cross-env ANALYZE=true bun run build",
    "analyze:experimental": "next experimental-analyze",
    "dev:inspect": "bun ./src/lib/scripts/dev.ts --inspect",
    "lighthouse": "bunx @unlighthouse/cli --site http://localhost:3000",
    "setup:project": "bun ./src/lib/scripts/setup-project.ts",
    "test": "bun test src/",
    "test:setup": "bun test lib/scripts/setup-project.test.ts",
    "doctor": "bun ./src/lib/scripts/doctor.ts",
    "generate": "plop",
    "handoff": "bun ./src/lib/scripts/prepare-handoff.ts",
    "sanity:extract": "cd lib/integrations/sanity && bun --env-file ../../../.env.local sanity schema extract",
    "sanity:typegen": "cd lib/integrations/sanity && bun --env-file ../../../.env.local sanity typegen generate && bun biome check --write --unsafe",
    "sanity:mcp": "bun ./src/lib/scripts/copy-sanity-mcp.ts",
    "test:e2e": "playwright test",
    "orchestrate": "gemini run agents-orchestrator"
  },
  "dependencies": {
    "@builder.io/partytown": "^0.10.0",
    "@next/third-parties": "^15.0.0",
    "@sanity/client": "^7.22.1",
    "@sentry/nextjs": "^10.63.0",
    "@shopify/hydrogen-react": "^2026.4.3",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.14",
    "@types/mousetrap": "^1.6.15",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "basehub": "latest",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "mousetrap": "^1.6.5",
    "next": "15.0.0",
    "next-sanity": "^13.0.8",
    "posthog-js": "^1.398.0",
    "react": "19.0.0-rc.1",
    "react-device-detect": "^2.2.3",
    "react-dom": "19.0.0-rc.1",
    "react-hook-form": "^7.50.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@unlighthouse/cli": "latest",
    "cross-env": "^7.0.3",
    "husky": "^9.0.0",
    "lint-staged": "^15.2.0",
    "plop": "^4.0.5",
    "tailwindcss": "^4",
    "ts-morph": "^25.0.0",
    "typescript": "^5"
  },
  "packageManager": "bun@1.0.0"
}
